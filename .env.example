# Copy to .env and fill in. .env is gitignored; this file is committed.

# --- Database -----------------------------------------------------------
# Host port Compose publishes Postgres on. Change it (and DATABASE_URL below)
# if something else already listens on 5432.
POSTGRES_PORT=5432

# Matches the docker-compose service. "postgresql+psycopg" selects psycopg 3.
DATABASE_URL=postgresql+psycopg://skillian:skillian@localhost:5432/skillian

# --- Adzuna -------------------------------------------------------------
# Free credentials: https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here
# ISO country code for the Adzuna endpoint (gb, us, in, au, ...).
# Adzuna partitions its API by country and returns salaries in that country's
# currency without labelling them, so this doubles as the currency hint.
ADZUNA_COUNTRY=in

# --- HTTP tuning --------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20.0
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_BASE_SECONDS=0.5

# --- Ingestion defaults -------------------------------------------------
# Adzuna caps results_per_page at 50.
RESULTS_PER_PAGE=50
MAX_PAGES=5

# --- Providers ----------------------------------------------------------
# Selects the implementation in app/providers/. Everything downstream talks to
# the ABC, so pointing at a hosted model later is a config change, not a rewrite.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- Ollama -------------------------------------------------------------
# Run `python scripts/check_ollama.py` after changing anything here.
OLLAMA_HOST=http://localhost:11434
# Pull both before first use:
#   ollama pull qwen2.5:7b
#   ollama pull nomic-embed-text
OLLAMA_LLM_MODEL=qwen2.5:7b
# 768-dimensional. Changing this model means an Alembic migration to resize the
# vector() columns -- they must match models.EMBEDDING_DIM.
OLLAMA_EMBED_MODEL=nomic-embed-text
# A 7b model on CPU can take well over a minute on a long resume.
OLLAMA_TIMEOUT_SECONDS=180.0

# --- Extraction ---------------------------------------------------------
# Attempts for the validate-and-retry loop in app/structure.py.
EXTRACTION_MAX_ATTEMPTS=3

LOG_LEVEL=INFO
